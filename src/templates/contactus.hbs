<!doctype html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>{{contact_us}}</title>
    <link rel="stylesheet" href="assets/css/style-{{dir}}.min.css">
     {{>loader}}
</head> 
<body>
  
<header class="main-header"  >
	{{>topbar}}   
  	{{>navbar active='contactus'}} 
</header>  
{{>pageheader image='contact-header.jpg' title=contact_us}}

 
<section class="contact_us_text ">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center ">
               <p class=" animate fadeInUp"  data-wow-duration="600ms" data-wow-delay="100ms"> {{contact_us_text}}</p>
            </div>
        </div>
    </div>
</section>



<section class="contact-form">
    <div class="container-fluid p-0">
        <div class="row no-gutters">
            <div class="col-lg-4 col-md-6 c-info text-center">
                    <article>
                        <h4 class="c-tit animate fadeIn"  data-wow-duration="600ms" data-wow-delay="100ms">
                            <strong>{{contact_info}}</strong></h4>
                            <ul class="list-unstyled">
                    <li class="animate fadeInUp"      data-wow-delay="150ms">
                             <strong> 
                                    <svg class="icon">
                                    <use xlink:href="#pinmap" />
                                    </svg>
                                 {{address}}</strong>
                        <address>
                            {{{address_text}}}  
                        </address>
                    </li>
                    
                    <li class="animate fadeInUp"     data-wow-duration="600ms" data-wow-delay="200ms">
                        <strong>
                            <svg class="icon">
                            <use xlink:href="#phone-call" />
                            </svg>
                            {{phone}}</strong>
                        <span class="number" dir="ltr">
                              +966114452929
                        </span>
                    </li>
                     <li class="animate fadeInUp"    data-wow-duration="600ms" data-wow-delay="250ms">
                        <strong>
                            <svg class="icon">
                            <use xlink:href="#fax" />
                            </svg>

                            {{fax}}</strong>
                        <span class="number" dir="ltr">
                              +966113254789
                        </span>
                    </li>
                    <li class="animate fadeInUp"    data-wow-duration="600ms" data-wow-delay="300ms">
                        <strong>
                             <svg class="icon">
                            <use xlink:href="#mail" />
                            </svg>
                              {{email}}</strong>
                        <a href="mailto:info@cedme.com">info@cedme.com</a>
                    </li>
                </ul>
                <nav class="d-flex">
                    <a href="https://www.facebook.com/ced.est.sa/" target="_blank"
                    class="animate fadeInUp"    data-wow-duration="600ms" data-wow-delay="100ms">
                            <i class="fa fa-facebook"></i>
                        </a>
                        <a href="https://twitter.com/ced_est" target="_blank"
                        class="animate fadeInUp"     data-wow-duration="600ms" data-wow-delay="150ms">
                            <i class="fa fa-twitter"></i>
                        </a>
                         <a href="#" target="_blank" 
                         class="animate fadeInUp"     data-wow-duration="600ms" data-wow-delay="200ms">
                            <i class="fa fa-youtube"></i>
                        </a>
                         <a href="https://www.linkedin.com/company/construction-edifices-development-est." target="_blank" 
                         class="animate fadeInUp"     data-wow-duration="600ms" data-wow-delay="250ms">
                            <i class="fa fa-linkedin"></i>
                        </a>
                </nav>
                 
                    </article>
        
                   </div>

            <div class="col-lg-8 col-md-6 c-form"> 
                <h4 class="c-tit gold"><strong>{{message_us}}</strong></h4> 
                    <div class="row no-gutters">
                        <div class=" col-lg-10">
                            

                                <form>
                                    <div class="form-row">
                                        <div class="form-group col-md-12 col-lg-6">
                                        <label for="name" class="animate fadeInDown"  data-wow-duration="600ms"  data-wow-delay="100ms">{{name}}</label>
                                        <input type="text" class="form-control rounded-0 form-control-lg animate fadeInUp"  data-wow-duration="600ms"  data-wow-delay="150ms" id="" placeholder="{{full_name}}">
                                        </div>

                                        <div class="form-group col-md-12 col-lg-6">
                                        <label for="email" class="animate fadeInDown"  data-wow-duration="600ms"  data-wow-delay="200ms" >{{email}}</label>
                                        <input type="email" class="form-control rounded-0 form-control-lg animate fadeInUp"  data-wow-duration="600ms"  data-wow-delay="250ms" id="" placeholder="{{email}}">
                                        </div>
                                    </div>
                                    <div class="form-group">
                                    <label for="message" class="animate fadeInDown"  data-wow-duration="600ms"  data-wow-delay="300ms">{{message}}</label>
                                    <textarea class="form-control rounded-0 form-control-lg animate fadeInUp"  data-wow-duration="600ms"  data-wow-delay="350ms" id="message" rows="3" placeholder="{{message}}"></textarea>
                                  </div>
                                   <div class="form-group">
                                       <button type="submit " class=" rounded-0 btn btn-outline-gold btn-lg pl-5 pr-5">{{send}}</button>
                                   </div>
                                   
                            </form>
                        </div>
                    </div>
            </div>
        </div>
    </div>
</section>




{{>map}}
{{>footer}} 
{{>bottombar}}

<script src="assets/js/script.min.js"></script> 


