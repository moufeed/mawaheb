<!doctype html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>{{our_projects}}</title>
    <link rel="stylesheet" href="assets/css/style-{{dir}}.min.css">
    {{>loader}}
</head> 
<body>
  
<header class="main-header"  >
	{{>topbar}}   
  	{{>navbar active='projects'}}  
</header>  
  
 {{>pageheader image='projects-header.jpg' title=our_projects}}

<section> 
    <div class="container">
         <div class="row justify-content-center mb-5 ">
                <div class="col text-center pt-5">
                    <p class="lead">{{our_projects_text}}</p>
                </div>
         </div>
         <div class="row pt-5 pb-5">
             {{#each our_projects_list}}
               <div class="col-md-6 col-lg-4">
                   <figure class="project-item animate fadeInUp"  data-wow-duration="600ms"  data-wow-delay="{{delay 20 @index }}ms">
						<img src="assets/img/our_projects/{{img}}" alt="img-{{@index}}">
						<figcaption>
							<h4>{{name}}</h4>
							<div> 
								<p>{{text}}</p>
							</div>
							<a href="{{link}}">{{../read_more}}</a>
						</figcaption>			
					</figure>
               </div>
             {{/each}}
         </div>
         <div class="row">
             <div class="col">
                 <nav aria-label="Page navigation  " class="mb-5">
                    <ul class="pagination justify-content-end">
                        <li class="page-item ">
                        <a class="page-link rounded-0" href="#" tabindex="-1">Previous</a>
                        </li>
                        <li class="page-item"><a class="page-link" href="#">1</a></li>
                        <li class="page-item active"><a class="page-link" href="#">2</a></li>
                        <li class="page-item"><a class="page-link" href="#">3</a></li>
                        <li class="page-item">
                        <a class="page-link rounded-0" href="#">Next</a>
                        </li>
                    </ul>
                    </nav>
             </div>
         </div>
    </div>
</section>

 
{{>footer}} 
{{>bottombar}}
<script src="assets/js/script.min.js"></script> 
</body>  
</html>  