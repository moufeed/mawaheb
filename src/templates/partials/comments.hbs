 {{#switch type}}
    {{#case "one"}}
            <form action="" class="comments-form mb-5 mx-3">
                <h4 class="title-border"><strong>أضف تعليقاً</strong></h4>

                <div class="form-row">
                    <div class="col-md-6">
                        <input type="text" name="name" id="name" placeholder="الاسم الاول" class="form-control form-control-lg rounded-0">
                    </div>
                    <div class="col-md-6">
                        <input type="email" name="name" id="name" placeholder="الاسم الاول" class="form-control form-control-lg rounded-0">
                    </div>
                </div>
                <div class="form-row mt-3">
                    <div class="col-12">
                        <textarea name="" id="" cols="30" rows="5" class="form-control form-control-lg rounded-0"  placeholder="التعليق" ></textarea>
                    </div>
                    <div class="col-12 mt-2"> 
                        <button class="btn btn-success  rounded-0" type="submit">ارسل</button>
                    </div>
                </div>
            </form>







<div class="comments-box mY-5 mx-3">
    <h4 class="title-border mb-4"><strong>التعليقات</strong></h4>

    <div class="">
         
            {{#each comments}}
            <div class="comment {{#if has_reply}} has_reply {{/if}} animate fadeIn" data-wow-duration="500ms" data-wow-delay="{{@index}}00ms" >
                    <header class="d-flex flex-wrap align-items-center">
                        <img src="assets/img/avaters/1.png" alt="" class="d-none d-md-block" width="40"> 
                        <span class="ml-auto meta">
                            <strong>{{name}} </strong>
                            <small><i class="fa fa-clock-o"></i> {{date}} </small>
                        </span>
                        <a href="#" class="reply-btn" data-id="c-{{@index}}"> 
                            الرد <i class="fa fa-reply"></i>
                        </a>
                    </header>
                     <div class="comment-body">
                         {{comment}}
                     </div>
                    
                    {{#if has_reply}} 
                    {{#each replies}}
                        <div class="comment reply">
                            <header class="d-flex flex-wrap align-items-center">
                                <img src="assets/img/avaters/2.png" alt="" class="d-none d-md-block" width="35">
                                <span class="ml-auto meta">
                                    <strong>   {{name}} </strong>
                                    <small><i class="fa fa-clock-o"></i> {{date}} </small>
                                </span>
                                <a href="#" class="reply-btn" >
                                    الرد <i class="fa fa-reply"></i>
                                </a> 
                            </header>
                             <div class="comment-body">
                                    {{comment}}
                                </div>  
                        </div>
                        {{/each}}
                    {{/if}}
            </div>
        {{/each}}
       
    </div>
</div>


 
 



