<footer class="main_footer pt-5 pb-5 ">
    <div class="container">
        <div class="row align-items-start">
            <div class="col-md-4 ">
                <div class="flogo">
                    <img src="assets/img/footer-logo.png" alt="footer logo" class="mb-4">
                    <p>{{our_vision_text}}</p>
                </div>
            </div>
            <div class="col-md-3 offset-md-1">
                <h4><strong>{{links}}</strong></h4>
                <ul class="list-unstyled links-list">

                    {{#each navigation}}
                    <li>
                        <a href="{{link}}">{{name}}</a>
                    </li>
                    {{/each}}
                </ul>
            </div>
            <div class="col-md-4">
                <h4><strong>{{contact}}</strong></h4>
                <ul class="list-unstyled info-list">
                    <li class="clearfix">
                        <i class="fa fa-map"></i>
                        <address>
                            {{{address_text}}}  
                        </address>
                    </li>
                    <li class="clearfix">
                        <i class="fa fa-clock-o"></i>
                        <span class="number" dir="ltr">
                                07:00 - 18:00
                        </span>
                    </li>
                    <li class="clearfix">
                        <i class="fa fa-phone-square"></i>
                        <span class="number" dir="ltr">
                              +966114452929
                        </span>
                    </li>
                     <li class="clearfix">
                        <i class="fa fa-fax"></i>
                        <span class="number" dir="ltr">
                              +966113254789
                        </span>
                    </li>
                    <li class="clearfix">
                        <i class="fa fa-envelope"></i>
                        <a href="mailto:info@cedme.com">info@cedme.com</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</footer>