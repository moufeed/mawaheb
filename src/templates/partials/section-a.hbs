
<section class="section-news section-a row no-gutters " data-cate="منوعات">
   {{#each section_a}}
           {{#switch type}}
                {{#case "full"}}
                <div class="sec-item full-width row no-gutters align-items-end line-violet-bottom">
                    <div class="col-md-5 p-0">
                        <div class="img-col">
                                 <img src="assets/img/news/{{@index}}.jpg" alt="">
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-5 offset-md-1">
                         <article>
                             <h3><a href="">{{title}}</a></h3>
                            <p>{{text}}</p>
                       
                         <footer class="d-flex  align-items-center">
                                <span class="writer-img">
                                    <img src="assets/img/avaters/0.png" alt="">
                                </span>
                                <span class="ml-auto"> 
                                    <p><i class="fa fa-user-o"></i> {{writer}}</p>
                                    <p><i class="fa fa-clock-o"></i> {{date}}</p>
                                
                                </span>
                                <a href="#" class="btn btn-outline-light ">
                                    {{../read_more}}
                                </a>
                         </footer>
                        </article>
                    </div>
                </div>
                   
                {{/case}}
                {{#case "bg-img"}}
                
                {{/case}}
                {{#default}}
                
                {{/default}}    
            {{/switch}}
   {{/each}}

</section>  


 



 