<section class="services-section">
    <div class="container-fluid p-0">
        <div class="row no-gutters">
                <div class="col-lg-4  d-md-none d-lg-block">
                    <div class="img-box">
                    <img src="assets/img/services-bg.jpg" alt="">
                    </div>
                </div>
                <div class="col-lg-8  ">
                    <div class="services_list">
                           <header   >
                                <h3 class="animate fadeIn"   data-wow-duration="600ms" data-wow-delay="100ms"><strong>{{our_services}}</strong></h3>
                                 <p class="animate fadeIn"  data-wow-duration="600ms" data-wow-delay="150ms">{{our_services_text}}</p>
                           </header>
                    <div class="row justify-content-between m-0 align-items-center">
                            {{#each our_services_list}}
                               <div class="col-md-4 col-sm-6"> 
                                   <div class=" service-item animate fadeIn"   data-wow-duration="600ms" data-wow-delay="{{@index}}00ms">
                                        <figure >
                                            <img src="assets/img/services/{{img}}" alt="">
                                            <figcaption>
                                                <h4>{{name}}</h4>
                                                <a href="services{{#isequal ../dir 'rtl'}}-rtl{{/isequal}}.html">{{../read_more}}</a>
                                            </figcaption>
                                        </figure>
                                   </div>
                               </div>
                            {{/each}}
                    </div>
                    </div>
                </div>
        </div>
    </div>
</section>