{{#switch type}}
    {{#case "one"}}
            <header class="row no-gutters align-items-center">
    <div class="col-md-12 post-title">
        <h2 class="title-border"><strong>{{post.title}}</strong></h2>
    </div>
    <div class="col-md-3 col-lg-2 align-self-end">
        <div class="post-meta">
                <span>
                    <i class="fa fa-calendar-o" ></i>
                    <strong>الثلاثاء 26 ديسمبر 2017</strong>
                </span>
                <span>
                    <i class="fa fa-eye"></i>
                    <strong class="en">{{random 280 500}}</strong>
                </span>
                <span>
                    <i class="fa fa-comments"></i> 
                    <strong class="en">{{random 280 500}}</strong>
                </span>
        </div>
    </div>
    <div class="col-md-9 col-lg-10">
        <img src="assets/img/post/1.jpg" class="img-fluid post-main-image" alt="">
    </div>
</header> 
    {{/case}}
{{/switch}}

