 <!doctype html>
<html class="no-js">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>{{home}}</title>
    <link rel="stylesheet" href="assets/css/style-{{dir}}.min.css">
    <link rel="stylesheet" href="assets/plugins/video-js/video-js.min.css">
    <link rel="stylesheet" href="assets/css/slider.min.css">
    <script src="assets/js/queryloader2.min.js" ></script>
    {{>imgloader}}
</script>
</head>
<body>
      
<div class="container full-height bg-white bg-shadow p-0">
{{>header }}
 
  <section class="page-header row no-gutters align-items-end" style="background-image:url('assets/img/bg-header.jpg')">
         <div class="col p-4">
             <h2>منوعات</h2>
             <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="index.html">الرئيسية</a></li>
                    <li class="breadcrumb-item"><a href="category.html">منوعات</a></li>
                    <li class="breadcrumb-item active" aria-current="page">{{post.title}}</li>
                </ol>
            </nav>
         </div>
</section>

<section class="post pt-5 post-three">
    <div class="row no-gutters justify-content-between">
        <div class="col-md-8 ">
        {{>post-header type="three"}} 
            <p class="lead mb-10 p-4 text-capitalize">{{post.text_1}}</p>
             {{>post-gallery type="three"}}
            <div class="post-content p-3 " id="postcontent">
                
                <p>{{post.text_2}}</p>
                <div class="embed-responsive embed-responsive-16by9 mb-2">
                <iframe class="embed-responsive-item" src="https://www.youtube.com/embed/O5QolgdnnGE"  allow="autoplay; encrypted-media"  allowfullscreen></iframe>
                </div>
                 <p >{{post.text_3}}</p>
            </div>


            {{>share-buttons type='text'}}
            {{>related_post type= "three"}} 
            {{>comments type='three'}}
        </div>



        <aside  class="col-md-4 aside">
            {{>sidebar}}
        </aside>
</section>
{{>social-section}} 
{{>footer}}
</div> 
{{>searchbox}}
  
<script src="assets/js/script.min.js"></script>
 
<script src="assets/plugins/video-js/video.min.js"></script>

 

<script>
        $(document).ready(function(){
            $('#postgallery').owlCarousel({
                margin:0,
                nav:false,
                dots:true ,
                rtl : true,
                autoplay :false,
                  items:1
            }) 

            $('#related-post').owlCarousel({
                    margin: 5,
                    nav: true,
                    rtl: true,
                    dots: false,
                    navText : ['&#xf101;','&#xf100;'], 
                    autoplay: true,
                    loop: true,
                    responsive : {
                        0 : {items:1},
                         480 : {items:1},
                        768 : {items:1} ,
                        1024 : {items:2} 
                        }
                })

        })

</script>
</body> 
</html>  
 
 