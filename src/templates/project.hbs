<!doctype html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>{{pagetitle}}</title>
    <link rel="stylesheet" href="assets/css/style-{{dir}}.min.css">
    {{>loader}}
</head> 
<body>
  
<header class="main-header"  >
	{{>topbar}}   
  	{{>navbar active='projects'}} 
</header>  
  {{>pageheader image='project-header.jpg' title="page name"}}

   <section> 
       <div class="container"> 
           <div class="row">
               <div class="col-md-5 col-lg-4 pt-5 pb-5 project-info ">
                    <h6 class="c-tit gold mb-4  animte fadeIn"  data-wow-duration='600ms'  data-wow-delay='100ms'><strong>{{project_info.title}}</strong></h6>
                    {{{project_info.text}}} 
               </div>
              
               <div class="col-md-7 col-lg-8 pt-5 pb-5">
                    <div class="main-image mb-4 animate fadeInUp"  data-wow-duration="600ms"  data-wow-delay="100ms">
                        <img src="assets/img/project/main.jpg" alt="" class="img-fluid ">
                    </div>
                     <div class="d-flex flex-wrap project-images">
                            {{#each project_info.imgs}}
                         <a href="assets/img/project/{{this}}" class="w-25 animate fadeInUp"  data-wow-duration="600ms"  data-wow-delay="{{delay 50 @index }}0ms"  data-fancybox="galery" data-caption="image-{{this}}">
                             <img src="assets/img/project/{{this}}" class="img-fluid" alt="img-{{this}}">
                         </a>
                         {{/each}}
                     </div>
               </div>
           </div>
       </div>
   </section>

{{>footer}} 
{{>bottombar}}
<script src="assets/js/script.min.js"></script> 
</body> 
</html>  
 