 <!doctype html>
<html class="no-js">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>{{home}}</title>
    <link rel="stylesheet" href="assets/css/style-{{dir}}.min.css">
    <link rel="stylesheet" href="assets/plugins/video-js/video-js.min.css">
    <link rel="stylesheet" href="assets/css/slider.min.css">
    <script src="assets/js/queryloader2.min.js" ></script>
    {{>imgloader}}
</script>
</head>
<body>
      
<div class="container full-height bg-white bg-shadow p-0">
{{>header }}
 
  <section class="page-header row no-gutters align-items-end" style="background-image:url('assets/img/bg-header.jpg')">
         <div class="col p-4">
             <h2>منوعات</h2>
             <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="index.html">الرئيسية</a></li>
                    <li class="breadcrumb-item"><a href="category.html">منوعات</a></li>
                    <li class="breadcrumb-item active" aria-current="page">{{post.title}}</li>
                </ol>
            </nav>
         </div>
</section>

<section class="post pt-5 post-one">
    <div class="row no-gutters justify-content-between">
        <div class="col-md-8 ">
            {{>post-header type="one"}}  
            {{>post-gallery type="one"}}
            <div class="d-flex  justify-content-between p-3 border-bottom">
                <span>
                    تم النشر بواسطة  <strong> احمد سرحان </strong>
                </span>
                
                <div class="btn-group btn-group-sm" role="group" aria-label="font-size">
                    <button type="button" class="btn btn-secondary en increasefont" > A+</button>
                    <button type="button" class="btn btn-secondary en decreasefont"> A- </button>
                </div>
            </div>


            <div class="post-content p-3" id="postcontent">
                <p>{{post.text_1}}</p>
                <p>{{post.text_2}}</p>
                <div class="embed-responsive embed-responsive-16by9 mb-2">
                <iframe class="embed-responsive-item" src="https://www.youtube.com/embed/O5QolgdnnGE"  allow="autoplay; encrypted-media"  allowfullscreen></iframe>
                </div>
                 <p >{{post.text_3}}</p>
            </div>


            {{>share-buttons type='full'}}
            {{>related_post type= "one"}} 
            {{>comments type='one'}}
        </div>



        <aside  class="col-md-4 aside">
            {{>sidebar}}
        </aside>
</section>
{{>social-section}} 
{{>footer}}
</div> 
{{>searchbox}}
  
<script src="assets/js/script.min.js"></script>
 
<script src="assets/plugins/video-js/video.min.js"></script>

 

<script>
        $(document).ready(function(){
            $('#postgallery').owlCarousel({
                margin:10,
                nav:true,
                rtl : true,
                navText : ['&#xf101;','&#xf100;'], 
                autoplay :true,
                responsive : {
                0 : {
                   items:1,
                },
                480 : {
                   items:2,
                },
                768 : {
                  items:3,
                } ,
                 1200 : {
                  items:4, 
                } 
                }
            }) 
            $('#related-post').owlCarousel({
                margin:10,
                nav:false,
                rtl : true,
                loop : true,
                autoplay :true,
                responsive : {
                0 : {
                   items:1,
                },
                480 : {
                   items:2,
                },
                768 : {
                  items:2,
                } ,
                 1200 : {
                  items:3, 
                } 
                }
            }) 
        //-  -/-----

          $('.reply-btn').click((e)=>{
              e.preventDefault(); 
                 $("html, body").animate({ 
                 scrollTop: $('.comments-form').offset().top - 30
              }, 350);
           })
        })
</script>
</body> 
</html>  
 
 